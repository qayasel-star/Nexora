<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RegistroInformatico" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#020817</item>
        <item name="android:statusBarColor">#030A1C</item>
        <item name="android:navigationBarColor">#030A1C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.RegistroInformatico.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#020817</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenIconBackgroundColor">#03152F</item>
        <item name="postSplashScreenTheme">@style/Theme.RegistroInformatico</item>
    </style>
</resources>
